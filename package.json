{
  "name": "hishob",
  "version": "1.0.0",
  "description": "personal budget tracker",
  "main": "electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client:build": "npm run build --prefix client",
    "desktop": "npm run client:build && electron .",
    "desktop:dev": "concurrently \"npm run client\" \"wait-on tcp:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "desktop:pack": "npm run client:build && electron-builder --dir",
    "desktop:dist": "npm run client:build && electron-builder --win",
    "client-build": "cd client && npm run build",
    "electron": "electron .",
    "dist": "npm run client-build && electron-builder"
  },
  "author": "Devarsh Naik",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "colours": "^0.6.0-2",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.devarshnaik.hishob",
    "productName": "Hishob",
    "icon": "hishob_fav.png",
    "extraResources": [
      ".env"
    ],
    "files": [
      "electron/**/*",
      "client/build/**/*",
      "controllers/**/*",
      "routers/**/*",
      "models/**/*",
      "middleware/**/*",
      "config/**/*",
      "server.js",
      "package.json",
      "package-lock.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
